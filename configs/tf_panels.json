      "description": "7 TFs shared across cell lines for cross-cell comparison",
      "tfs": ["CTCF", "MYC", "MAX", "CEBPB", "REST", "YY1", "NRF1"],
      "notes": "Selected for availability across K562, HepG2, and WTC11"
    },
    "20tf": {
      "description": "Extended panel of 20 TFs covering major families",
      "tfs": [
        "CTCF", "GATA1", "TAL1", "MYC", "MAX", "SPI1", "CEBPB",
        "REST", "YY1", "NRF1", "JUND", "FOS", "ATF3", "MAFK",
        "BACH1", "NFE2L2", "ELF1", "GABPA", "USF1", "USF2"
      ],
      "families": {
        "zinc_finger": ["CTCF", "REST", "YY1"],
        "gata": ["GATA1"],
        "bhlh": ["TAL1", "MYC", "MAX", "USF1", "USF2"],
        "ets": ["SPI1", "ELF1", "GABPA"],
        "bzip": ["CEBPB", "JUND", "FOS", "ATF3", "MAFK", "BACH1", "NFE2L2", "NRF1"]
      }
    }
  },
  "cell_lines": {
